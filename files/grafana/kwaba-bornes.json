        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (collectd_cpu_percent{instance=~\"$borne\",type!=\"idle\"}) / count by (instance) (collectd_cpu_percent{instance=~\"$borne\",type=\"user\"})",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
