{
  "uid": "kwaba-bornes",
  "title": "kwaba - bornes",
  "tags": [
    "kwaba",
    "openwrt",
    "collectd"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "Autres dashboards kwaba",
      "type": "dashboards",
      "tags": [
        "kwaba"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "description": "Métriques collectd des bornes OpenWrt kwaba-wifi (envoi toutes les 30 s).",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        }
      },
      {
        "name": "borne",
        "label": "Borne",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(collectd_uptime, instance)",
          "refId": "A"
        },
        "definition": "label_values(collectd_uptime, instance)",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "interface",
        "label": "Interface",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(collectd_interface_if_octets_rx_total{instance=~\"$borne\"}, interface)",
          "refId": "A"
        },
        "definition": "label_values(collectd_interface_if_octets_rx_total{instance=~\"$borne\"}, interface)",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Vue d'ensemble",
      "id": 2,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Bornes qui envoient",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Bornes dont collectd a envoyé des mesures dans les 2 dernières minutes.",
      "gridPos": {
        "h": 7,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(collectd_uptime{instance=~\"$borne\"}) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "type": "table",
      "title": "État des bornes",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 20,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "collectd_uptime{instance=~\"$borne\"}",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "collectd_load_shortterm{instance=~\"$borne\"}",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "C",
          "expr": "sum by (instance) (collectd_cpu_percent{instance=~\"$borne\",type!=\"idle\"}) / count by (instance) (collectd_cpu_percent{instance=~\"$borne\",type=\"user\"})",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "D",
          "expr": "collectd_memory_percent{instance=~\"$borne\",memory=\"used\"}",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "E",
          "expr": "sum by (instance) (collectd_iwinfo_stations{instance=~\"$borne\"})",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "F",
          "expr": "max by (instance) (collectd_thermal_temperature{instance=~\"$borne\"})",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "G",
          "expr": "max by (instance) (collectd_ping{instance=~\"$borne\",ping=\"1.1.1.1\"})",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "H",
          "expr": "max by (instance) (collectd_ping{instance=~\"$borne\",ping=\"192.168.1.1\"})",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "I",
          "expr": "100 * sum by (instance) (collectd_df_df_complex{instance=~\"$borne\",df=\"overlay\",type=\"used\"}) / sum by (instance) (collectd_df_df_complex{instance=~\"$borne\",df=\"overlay\"})",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "endpoint": true,
              "namespace": true,
              "pod": true,
              "service": true,
              "container": true,
              "memory": true,
              "ping": true
            },
            "renameByName": {
              "instance": "Borne",
              "Value #A": "Uptime",
              "Value #B": "Charge 1 min",
              "Value #C": "CPU %",
              "Value #D": "Mémoire %",
              "Value #E": "Clients Wi-Fi",
              "Value #F": "Temp. max °C",
              "Value #G": "Ping Internet ms",
              "Value #H": "Ping routeur ms",
              "Value #I": "Flash /overlay %"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center"
          },
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Uptime"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Charge 1 min"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Mémoire %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Clients Wi-Fi"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Temp. max °C"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Ping Internet ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Ping routeur ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Flash /overlay %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU %"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 60
                    },
                    {
                      "color": "red",
                      "value": 85
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Borne",
            "desc": false
          }
        ]
      }
    },
    {
      "type": "row",
      "title": "Système",
      "id": 5,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "panels": []
    },
