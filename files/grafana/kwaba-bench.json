    {
      "id": 11,
      "type": "timeseries",
      "title": "Historique TCP (Mbit/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "kwaba_bench_tcp_mbps{site=\"$site\",mode=\"$mode\"}",
          "legendFormat": "{{de}} → {{vers}} {{sens}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "showPoints": "always",
            "pointSize": 4
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Évolution du débit TCP par paire : chaque marche = une nouvelle mesure (la valeur reste affichée jusqu'à la suivante). Une baisse durable sur une paire = lien qui se dégrade (distance, obstacle, interférences)."
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Historique latence moyenne (ms)",
      "datasource": {
        "type": "prometheus",
