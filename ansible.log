  cmd: |-
    {
    echo "===== LISTE DISQUES ====="
    lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINT,ROTA,SCHED,PHY-SEC,LOG-SEC
    echo ""
    echo "===== ESPACE DISQUE ====="
    df -h
    echo ""
    echo "===== IO SCHEDULERS ====="
    for dev in /sys/block/sd* /sys/block/nvme*; do
      [ -f "$dev/queue/scheduler" ] && echo "$dev: $(cat $dev/queue/scheduler)"
    done 2>/dev/null
    echo ""
    echo "===== IOSTAT ====="
    iostat -x 2 2 2>/dev/null || echo "iostat non disponible (apt install sysstat)"
    echo ""
    echo "===== LVM ====="
    vgs 2>/dev/null; lvs 2>/dev/null
    echo ""
    echo "===== SMART STATUS ====="
    for dev in /dev/sda /dev/sdb /dev/sdc /dev/sdd /dev/sde /dev/sdf; do
      [ -b "$dev" ] && { echo "--- $dev ---"; smartctl -H "$dev" 2>/dev/null | grep -E "SMART|result|PASSED|FAILED" || echo "smartctl non disponible"; }
    done
    } > /tmp/diag_node/07_disk_io.txt 2>&1
