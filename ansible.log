# Nettoyage préalable du répertoire de destination
rm -rf /tmp/diag_ansible/{{ inventory_hostname }}
mkdir -p /tmp/diag_ansible/{{ inventory_hostname }}

# Récupérer l'archive
scp -o StrictHostKeyChecking=no \
    -o BatchMode=yes \
    {{ ansible_user }}@{{ ansible_host }}:/tmp/diag_{{ inventory_hostname }}.tar.gz \
    /tmp/diag_ansible/{{ inventory_hostname }}.tar.gz

# Extraire directement dans le répertoire du noeud
# --strip-components=1 enlève le préfixe "diag_node/" du tar
tar xzf /tmp/diag_ansible/{{ inventory_hostname }}.tar.gz \
    -C /tmp/diag_ansible/{{ inventory_hostname }}/ \
    --strip-components=1

rm -f /tmp/diag_ansible/{{ inventory_hostname }}.tar.gz

echo "=== Fichiers rapatriés dans /tmp/diag_ansible/{{ inventory_hostname }}/ ==="
ls -la /tmp/diag_ansible/{{ inventory_hostname }}/
exit 0
